{
  "id": "024_account_balance_with_reversal",
  "description": "Account balance computation when a reversal entry negates an original. The reversed original MUST be excluded from typed totals but included in the balance computation (INV-2).",
  "category": "balance",
  "tags": ["balance", "reversal"],
  "given": {
    "tenantId": "t1",
    "parent": {"id": "par-001", "name": "Test Parent"},
    "students": [{"id": "stu-001", "parentId": "par-001", "gradeLevel": "1ap", "paymentPlan": "tranches"}],
    "ledgerEntries": [
      {
        "id": "led-1", "parentId": "par-001", "studentId": "stu-001",
        "category": "tuition", "amount": 10000000, "type": "charge",
        "sourceType": "installment", "sourceId": "ins-1",
        "actorId": "u1", "actorName": "Alice",
        "at": "2026-01-15T10:00:00Z",
        "description": "T1"
      },
      {
        "id": "led-2", "parentId": "par-001", "studentId": "stu-001",
        "category": "tuition", "amount": -5000000, "type": "payment",
        "sourceType": "payment", "sourceId": "pay-1",
        "method": "cash", "receiptNumber": "REC-1",
        "paymentStatus": "paid",
        "actorId": "u1", "actorName": "Alice",
        "at": "2026-02-15T10:00:00Z",
        "description": "Payment"
      },
      {
        "id": "led-3", "parentId": "par-001", "studentId": "stu-001",
        "category": "tuition", "amount": 5000000, "type": "reversal",
        "sourceType": "payment", "sourceId": "pay-1",
        "method": "cash", "receiptNumber": "REC-1",
        "paymentStatus": "paid",
        "reversesId": "led-2",
        "actorId": "u1", "actorName": "Alice",
        "at": "2026-02-20T10:00:00Z",
        "description": "Reversal of payment"
      }
    ],
    "installments": [],
    "payments": [],
    "academicYearStartYear": 2025
  },
  "when": {
    "type": "computeAccountBalance",
    "accountId": "parent:par-001:category:tuition:student:stu-001"
  },
  "then": {
    "balance": 10000000,
    "totalCharged": 10000000,
    "totalPaid": 0
  }
}
