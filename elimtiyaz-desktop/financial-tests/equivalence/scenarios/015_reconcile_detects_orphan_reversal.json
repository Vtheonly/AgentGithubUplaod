{
  "id": "015_reconcile_detects_orphan_reversal",
  "description": "A reversal entry that references a non-existent original. Reconciler MUST raise ORPHAN_REVERSAL error.",
  "category": "reconcile",
  "tags": ["reconcile", "orphan_reversal", "error"],
  "given": {
    "tenantId": "t1",
    "parent": {"id": "par-001", "name": "Test Parent"},
    "students": [],
    "ledgerEntries": [
      {
        "id": "led-1", "parentId": "par-001", "studentId": null,
        "category": "tuition", "amount": -5000000, "type": "reversal",
        "sourceType": "payment", "sourceId": "pay-1",
        "actorId": "u1", "actorName": "Alice",
        "at": "2026-02-15T10:00:00Z",
        "description": "Reversal of non-existent",
        "reversesId": "led-999-does-not-exist"
      }
    ],
    "installments": [],
    "payments": [],
    "academicYearStartYear": 2025
  },
  "when": {
    "type": "reconcileLedger",
    "includePayments": false,
    "includeInstallments": false,
    "includeParentSummaries": false
  },
  "then": {
    "pass": false,
    "violations": ["ORPHAN_REVERSAL"]
  }
}
