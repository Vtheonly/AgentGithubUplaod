{
  "id": "016_reconcile_detects_negative_on_non_parent_credit_account",
  "description": "A negative balance on a non-parent_credit account. Reconciler MUST raise UNBACKED_PARENT_CREDIT warning.",
  "category": "reconcile",
  "tags": ["reconcile", "unbacked_parent_credit"],
  "given": {
    "tenantId": "t1",
    "parent": {"id": "par-001", "name": "Test Parent"},
    "students": [{"id": "stu-001", "parentId": "par-001", "gradeLevel": "1ap", "paymentPlan": "tranches"}],
    "ledgerEntries": [
      {
        "id": "led-1", "parentId": "par-001", "studentId": "stu-001",
        "category": "tuition", "amount": 10000000, "type": "charge",
        "sourceType": "installment", "sourceId": "ins-1",
        "actorId": "u1", "actorName": "Alice",
        "at": "2026-01-15T10:00:00Z",
        "description": "T1"
      },
      {
        "id": "led-2", "parentId": "par-001", "studentId": "stu-001",
        "category": "tuition", "amount": -15000000, "type": "payment",
        "sourceType": "payment", "sourceId": "pay-1",
        "method": "cash", "receiptNumber": "REC-1",
        "paymentStatus": "paid",
        "actorId": "u1", "actorName": "Alice",
        "at": "2026-02-15T10:00:00Z",
        "description": "Overpayment on wrong account"
      }
    ],
    "installments": [],
    "payments": [],
    "academicYearStartYear": 2025
  },
  "when": {
    "type": "reconcileLedger",
    "includePayments": false,
    "includeInstallments": false,
    "includeParentSummaries": true
  },
  "then": {
    "violations": ["UNBACKED_PARENT_CREDIT"]
  }
}
