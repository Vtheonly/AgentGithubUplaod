{
  "id": "t345_resolver_config_wins",
  "description": "ADR-018/T-345: the configuration row (subject x year x level x direction) is the authoritative context — coefficient 4 for 4AM Arabe beats the directory's 3, and the per-context subjectCode overrides the directory code.",
  "category": "subject_configuration",
  "tags": [
    "subject_configuration",
    "resolver"
  ],
  "given": {
    "tenantId": "t1",
    "ledgerEntries": [],
    "subject": {
      "id": "subj-ar",
      "code": "AR",
      "coefficient": 3,
      "passingGrade": 10,
      "isExtracurricular": false
    },
    "configurations": [
      {
        "subjectId": "subj-ar",
        "academicLevelId": "al-4am",
        "academicYearId": "ay-1",
        "direction": "general",
        "coefficient": 4,
        "subjectCode": "ARB-4AM",
        "passingGrade": 10,
        "isExtracurricular": false,
        "isActive": true,
        "gradingRecipe": {
          "devoir1": 1,
          "devoir2": 1,
          "examen": 2,
          "cc": 1
        }
      }
    ],
    "context": {
      "academicLevelId": "al-4am",
      "academicYearId": "ay-1"
    }
  },
  "when": {
    "type": "resolveSubjectConfiguration"
  },
  "then": {
    "coefficient": 4,
    "subjectCode": "ARB-4AM",
    "source": "configuration",
    "recipe": {
      "devoir1": 1,
      "devoir2": 1,
      "examen": 2,
      "cc": 1
    }
  }
}
