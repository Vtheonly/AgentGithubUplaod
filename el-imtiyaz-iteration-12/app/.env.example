# ============================================================================
# El-Imtiyaz Desktop App — Vite Environment Variables
# ============================================================================
# Copy to .env.local and fill in. Vite exposes VITE_-prefixed vars to the
# renderer process. NEVER put secrets here.
# ============================================================================

# Supabase connection (only required when VITE_USE_SUPABASE=true)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY-PLACEHOLDER

# Toggle between mock (false) and Supabase (true) repository backends
VITE_USE_SUPABASE=false

# App metadata
VITE_APP_NAME=El-Imtiyaz
VITE_APP_VERSION=0.1.0
VITE_DEFAULT_LOCALE=fr
VITE_DEFAULT_CURRENCY=DZD
VITE_DEFAULT_TIMEZONE=Africa/Algiers
